# URL hash de acceso al panel visual

# Usuarios adicionales del panel (JSON array)
# Cada usuario: {"username": "nombre", "password": "clave"}

# ============================================================
# Seguridad (OBLIGATORIO definir por entorno)
# ============================================================
# Secreto para firmar/verificar peticiones HMAC de la API.
# Generar uno fuerte y NO reutilizar entre entornos.
API_HMAC_SECRET=CHANGE_ME_strong_random_secret

# CORS: origenes permitidos separados por coma. '*' solo para desarrollo.
# Ejemplo produccion: CORS_ALLOWED_ORIGINS=https://app.alocredit.co,https://admin.alocredit.co
CORS_ALLOWED_ORIGINS=*
